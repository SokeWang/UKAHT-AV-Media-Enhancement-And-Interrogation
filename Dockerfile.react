# Dockerfile.react
# Owner: Peidong Wang — React Frontend deployment
#
# Builds the production React frontend image.
# Run standalone:
#   docker build -f Dockerfile.react -t ukaht-frontend-react .
#   docker run -p 3000:80 ukaht-frontend-react

# Stage 1: Build
FROM node:22-alpine AS build

WORKDIR /app

# Copy package descriptors first to cache dependencies
COPY frontend-react/package.json frontend-react/package-lock.json ./
RUN npm ci

# Copy source code and build
COPY frontend-react/ ./
RUN npm run build

# Stage 2: Serve
FROM nginx:alpine

# Copy built files
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
