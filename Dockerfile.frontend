# Dockerfile.frontend
# Owner: Antigravity AI Assistant — Milestone 5 (containerisation)
#
# Builds the Streamlit frontend image.

FROM python:3.11-slim

WORKDIR /app

ENV PYTHONPATH=/app

# Install Streamlit and requests (no ML deps needed in the frontend container)
RUN pip install --no-cache-dir "streamlit>=1.35.0" "requests>=2.31.0"

# Copy frontend source
COPY frontend/ ./frontend/

# Expose Streamlit port
EXPOSE 8501

CMD ["streamlit", "run", "frontend/app.py", \
     "--server.port=8501", "--server.address=0.0.0.0", \
     "--server.headless=true"]
